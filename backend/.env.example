PORT=3000
HOST=127.0.0.1
NODE_ENV=production
IDENTITY_SECRET=replace-with-at-least-32-random-characters
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
APP_TIME_ZONE=Australia/Brisbane
LATEST_MOBILE_BUILD=8
# Build 7 is publicly available and remains supported alongside Build 8.
# Do not raise this value to 8. Production startup rejects that configuration.
MIN_SUPPORTED_MOBILE_BUILD=7
# Build 8 is live. Keep both Build 8 profile gates enabled during Build 9.
ENABLE_CUSTOM_DISORDERS=true
ENABLE_INDEPENDENT_PROFILES=true
# Build 9 patients may choose today or one of this many previous calendar days.
MAX_BACKDATE_DAYS=7
# Emergency containment only. When true, mobile enrolment, profile sync, and
# symptom uploads return HTTP 503 while staff repair collided identities.
ENROLMENT_INCIDENT_LOCKDOWN=false
PUBLIC_BASE_URL=https://tracker.melindapascoeneurology.com
GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=au.com.pascoeneurology.neurosol
APP_STORE_URL=https://apps.apple.com/app/id6796575355
# Optional Google Play review access. Keep all three blank unless a release is
# under review. Use a random 12-character code and a synthetic identity only.
REVIEW_ENROLMENT_CODE=
REVIEW_PATIENT_ID_PREFIX=
REVIEW_DISPLAY_NAME=
# Optional: store runtime clinical data outside the source directory.
# DATA_DIR=C:\ProgramData\NeuroSol\data
